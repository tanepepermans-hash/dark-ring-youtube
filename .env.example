# Geen van deze keys is momenteel vereist — er is nog geen automatisering aangesloten.
# Kopieer dit bestand naar `.env.local` (niet committen) zodra we een concrete stap
# samen automatiseren, en vul alleen dan de betreffende key in.
#
# Regel: API keys komen UITSLUITEND uit environment variables, nooit hardcoded in code.

# ElevenLabs (voice-over) — nodig zodra we voice-over generatie automatiseren
ELEVENLABS_API_KEY=

# YouTube Data API + Analytics API (fase 2: geautomatiseerd uploaden/analytics)
# OAuth client credentials uit Google Cloud Console
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optioneel, alleen als we research willen uitbreiden met live web-search
PERPLEXITY_API_KEY=

# Optioneel, alleen als stock tekortschiet en we AI-beeld/video willen testen
RUNWAY_API_KEY=
PIKA_API_KEY=
